# Only needed for `s2veg hub-token` / `s2veg hub-fetch`. STAC/COG access needs no credentials.
# Copy this file to `.env` (git-ignored) and fill it in. Never commit or paste real values.

# "sentinelhub" = Planet's Sentinel Hub (apps.sentinel-hub.com, trial then paid)
# "cdse"        = Copernicus Data Space Ecosystem (free, shapps.dataspace.copernicus.eu)
SH_PROVIDER=sentinelhub

# From Dashboard -> User settings -> OAuth clients -> Create. The secret is shown ONCE.
SH_CLIENT_ID=
SH_CLIENT_SECRET=
