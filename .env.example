# Needed for hub-token / hub-fetch / openeo-ndvi (OAuth) and cdse-s3 (S3 keys).
# STAC/COG access needs no credentials.
# Copy this file to `.env` (git-ignored) and fill it in. Never commit or paste real values.

# "sentinelhub" = Planet Insights Platform (OAuth client, NOT the Planet API key)
# "cdse"        = Copernicus Data Space Ecosystem (free)
SH_PROVIDER=cdse

# Planet: insights.planet.com/account -> Overview -> OAuth clients -> Create New
# CDSE:   shapps.dataspace.copernicus.eu/dashboard -> User settings -> OAuth clients
# The secret is shown ONCE. Do not use your email or the Planet API key (PLA...).
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# CDSE object storage (s2veg cdse-s3). NOT the OAuth client above.
# Create at https://eodata-s3keysmanager.dataspace.copernicus.eu/ — secret shown once.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
